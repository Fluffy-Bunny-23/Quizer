{
  "rules": {
    "sessions": {
      // Allow reading the sessions list (for cleanup, etc.)
      ".read": true,
      
      "$sessionId": {
        // Anyone can read individual session data
        ".read": true,
        
        // Only the non-anonymous host can create or modify session root properties
        ".write": "auth != null && auth.token.provider != 'anonymous' && ((!data.exists() && newData.child('hostUid').val() == auth.uid) || (data.exists() && data.child('hostUid').val() == auth.uid))",
        
        "players": {
          "$playerId": {
            // Players can only write their own data
            ".write": "auth != null && auth.uid == $playerId",
            
            // Validate on create: require name, role, score
            // Validate on update: only allow lastAnswer and answerTime to be numbers
            ".validate": "(newData.hasChildren(['name','role','score']) && newData.child('name').isString() && (newData.child('role').val()=='player' || newData.child('role').val()=='spectator') && newData.child('score').isNumber()) || (data.exists() && !newData.hasChildren(['name','role','score']) && (!newData.child('lastAnswer').exists() || newData.child('lastAnswer').isNumber()) && (!newData.child('answerTime').exists() || newData.child('answerTime').isNumber()))"
          }
        },
        
        "answers": {
          "$questionIndex": {
            "$playerId": {
              // Players can only submit their own answers, and only once per question
              ".write": "auth != null && auth.uid == $playerId && !data.exists()",
              
              // Validate answer data
              ".validate": "newData.hasChildren(['selectedIndex', 'timeMs']) && newData.child('selectedIndex').isNumber() && newData.child('selectedIndex').val() >= 0 && newData.child('selectedIndex').val() <= 3 && newData.child('timeMs').isNumber() && newData.child('timeMs').val() >= 0"
            }
          }
        }
      }
    }
  }
}
